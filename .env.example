# Database
DATABASE_URL=postgresql://leafit:leafit@localhost:5432/leafit

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-change-this-in-production

# OAuth (optional - comment out if not using)
# OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
# OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret

# S3-Compatible Storage (MinIO in dev)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=leafit
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Redis
REDIS_URL=redis://localhost:6379

# Compile Service
COMPILE_SERVICE_URL=http://localhost:3001

# Y-WebSocket Server
Y_WEBSOCKET_URL=ws://localhost:1234
NEXT_PUBLIC_Y_WEBSOCKET_URL=ws://localhost:1234

# Email (optional - for magic link)
# EMAIL_SERVER=smtp://user:pass@smtp.example.com:587
# EMAIL_FROM=noreply@leafit.dev
